---
import Icon from "./Icon.astro";
import WhatsAppButton from "./WhatsAppButton.astro";
import { services } from "../data/site";
---

<section id="services" class="bg-forest-900 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold tracking-[0.18em] text-leaf-400 uppercase">Services</p>
        <h2 class="mt-4 font-display text-3xl leading-tight font-semibold text-white sm:text-4xl lg:text-[2.75rem]">
          Everything your outdoor space needs
        </h2>
        <p class="mt-5 text-base leading-relaxed text-forest-100">
          Whether it is a full garden build or a monthly tidy-up, we handle the whole job in-house —
          no subcontractors, no handing you between teams.
        </p>
      </div>
      <WhatsAppButton label="Ask about a service" variant="leaf" class="shrink-0" />
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <article class="reveal group rounded-2xl bg-forest-800/70 p-7 ring-1 ring-white/10 transition-all duration-300 hover:-translate-y-1 hover:bg-forest-800 hover:ring-leaf-400/40">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-leaf-500/20 text-leaf-400 ring-1 ring-leaf-400/25 transition-colors group-hover:bg-leaf-500 group-hover:text-white group-hover:ring-leaf-500">
              <Icon name={service.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-5 font-display text-xl font-semibold text-white">{service.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-forest-100/85">{service.blurb}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
