---
import { process } from "../data/site";
---

<section id="process" class="py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold tracking-[0.18em] text-leaf-500 uppercase">How it works</p>
      <h2 class="mt-4 font-display text-3xl leading-tight font-semibold sm:text-4xl lg:text-[2.75rem]">
        Simple from first message to finished garden
      </h2>
    </div>

    <ol class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        process.map((item) => (
          <li class="reveal relative rounded-2xl border border-sand-200 bg-white p-7 shadow-sm">
            <span class="font-display text-4xl font-semibold text-sand-200">{item.step}</span>
            <h3 class="mt-3 font-display text-lg font-semibold">{item.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-forest-700">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
