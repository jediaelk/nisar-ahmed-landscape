---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import WhatsAppButton from "./WhatsAppButton.astro";
import { site } from "../data/site";
import ctaImage from "../images/site/cta.jpg";
---

<section class="relative overflow-hidden">
  <Image
    src={ctaImage}
    alt="A stepping-stone pathway set into artificial grass"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    quality={80}
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover object-center"
  />
  <div class="absolute inset-0 bg-forest-900/88"></div>

  <div class="reveal relative mx-auto max-w-3xl px-5 py-20 text-center lg:px-8 lg:py-24">
    <h2 class="font-display text-3xl leading-tight font-semibold text-white sm:text-4xl lg:text-[2.75rem]">
      Get in touch and receive a free quote
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-forest-100">
      Tell us what you have in mind. We will visit, measure up and send you a clear price — no
      obligation, no pressure.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <WhatsAppButton label="WhatsApp us now" class="px-7 py-4 text-base" />
      <a
        href={site.phone.tel}
        class="inline-flex items-center gap-2.5 rounded-full border border-white/25 px-7 py-4 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:bg-white/10"
      >
        <Icon name="phone" class="h-5 w-5" />
        {site.phone.display}
      </a>
    </div>
  </div>
</section>
